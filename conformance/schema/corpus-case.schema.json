{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.agent-ix.org/filament-core-data/conformance/v1/corpus-case.schema.json",
	"title": "Conformance corpus case v1",
	"type": "object",
	"required": [
		"id",
		"title",
		"family",
		"class",
		"kind",
		"contractVersion",
		"base",
		"ops",
		"covers",
		"decidedBy",
		"derivedFrom",
		"provenance",
		"expected"
	],
	"properties": {
		"id": { "$ref": "#/$defs/caseId" },
		"title": { "type": "string", "minLength": 1 },
		"family": { "$ref": "#/$defs/family" },
		"class": { "enum": ["positive", "negative", "boundary", "evolution"] },
		"kind": { "enum": ["document", "compatibility"] },
		"contractVersion": { "enum": ["2.0.0"] },
		"base": { "type": "string", "minLength": 1 },
		"ops": { "type": "array", "items": { "$ref": "#/$defs/op" } },
		"beforeBase": { "type": "string", "minLength": 1 },
		"beforeOps": { "type": "array", "items": { "$ref": "#/$defs/op" } },
		"covers": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 },
			"uniqueItems": true
		},
		"decidedBy": { "enum": ["schema", "cross-field", "compatibility"] },
		"derivedFrom": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["artifact", "locator", "quote"],
				"properties": {
					"artifact": { "type": "string", "minLength": 1 },
					"locator": { "type": "string", "minLength": 1 },
					"quote": { "type": "string", "minLength": 1 }
				},
				"additionalProperties": false
			}
		},
		"provenance": {
			"type": "object",
			"required": ["authoredFor", "blessedFromRun"],
			"properties": {
				"authoredFor": { "type": "string", "minLength": 1 },
				"blessedFromRun": { "type": "boolean" },
				"reproduces": { "type": "string", "minLength": 1 },
				"blessing": {
					"type": "object",
					"required": ["implementation", "version", "command", "reviewer"],
					"properties": {
						"implementation": { "type": "string", "minLength": 1 },
						"version": { "type": "string", "minLength": 1 },
						"command": { "type": "string", "minLength": 1 },
						"reviewer": { "type": "string", "minLength": 1 }
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"unsupportedBy": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["adapter", "owningIssue", "rationale"],
				"properties": {
					"adapter": { "type": "string", "minLength": 1 },
					"owningIssue": { "type": "string", "minLength": 1 },
					"rationale": { "type": "string", "minLength": 1 }
				},
				"additionalProperties": false
			}
		},
		"expected": {
			"type": "object",
			"required": ["resultState", "diagnostics"],
			"properties": {
				"resultState": { "enum": ["success", "invalid", "lossy"] },
				"diagnostics": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["pointer", "diagnostic"],
						"properties": {
							"pointer": { "type": "string" },
							"diagnostic": {
								"$ref": "https://schemas.agent-ix.org/filament-core-data/v1/common.schema.json#/$defs/diagnostic"
							}
						},
						"additionalProperties": false
					}
				},
				"classification": {
					"enum": [
						"patch",
						"additive",
						"conditional",
						"breaking",
						"unknown",
						"invalid"
					]
				}
			},
			"additionalProperties": false
		}
	},
	"allOf": [
		{
			"if": {
				"type": "object",
				"properties": { "kind": { "const": "compatibility" } }
			},
			"then": {
				"type": "object",
				"required": ["beforeBase", "beforeOps"],
				"properties": {
					"expected": { "type": "object", "required": ["classification"] }
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": { "class": { "const": "positive" } }
			},
			"then": {
				"type": "object",
				"properties": {
					"expected": {
						"type": "object",
						"properties": {
							"resultState": { "const": "success" },
							"diagnostics": { "type": "array", "maxItems": 0 }
						}
					}
				}
			}
		}
	],
	"additionalProperties": false,
	"$defs": {
		"caseId": {
			"type": "string",
			"pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*-[0-9]{3}$"
		},
		"family": {
			"enum": [
				"envelope",
				"identity",
				"scalar",
				"alias",
				"enum",
				"sequence-map",
				"union",
				"reference",
				"field-presence",
				"field-default",
				"unit",
				"constraint",
				"recursion",
				"relationship",
				"operation",
				"clause",
				"provenance",
				"unknown",
				"extension",
				"package",
				"version",
				"compatibility"
			]
		},
		"op": {
			"type": "object",
			"required": ["op"],
			"properties": {
				"op": {
					"enum": [
						"add",
						"remove",
						"replace",
						"copy",
						"move",
						"test",
						"x-repeat"
					]
				},
				"path": { "type": "string" },
				"from": { "type": "string" },
				"value": true,
				"count": { "type": "integer", "minimum": 1, "maximum": 512 },
				"template": true
			},
			"additionalProperties": false
		}
	}
}
