{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.agent-ix.org/filament-core-data/conformance/v1/corpus-manifest.schema.json",
	"title": "Conformance corpus manifest v1",
	"type": "object",
	"required": [
		"corpusVersion",
		"contractVersions",
		"canonicalForm",
		"caseIdPattern",
		"minimizationBudget",
		"depthLimit",
		"repeatLimit",
		"contractArtifacts",
		"predecessor",
		"familyPrefixes",
		"constructRegister",
		"bases",
		"cases",
		"corpusDigest"
	],
	"properties": {
		"corpusVersion": {
			"$ref": "https://schemas.agent-ix.org/filament-core-data/v1/common.schema.json#/$defs/semver"
		},
		"contractVersions": {
			"type": "array",
			"minItems": 1,
			"items": { "enum": ["1.0.0", "1.1.0", "1.2.0"] },
			"uniqueItems": true
		},
		"canonicalForm": { "const": "agent-ix-conformance-jcs-v1" },
		"caseIdPattern": { "type": "string", "minLength": 1 },
		"minimizationBudget": { "type": "integer", "minimum": 1 },
		"depthLimit": { "type": "integer", "minimum": 1 },
		"repeatLimit": { "type": "integer", "minimum": 1 },
		"predecessor": {
			"type": "object",
			"required": ["state", "ref", "rationale"],
			"properties": {
				"state": { "enum": ["none", "required"] },
				"ref": { "type": "string", "minLength": 1 },
				"rationale": { "type": "string", "minLength": 1 }
			},
			"additionalProperties": false
		},
		"contractArtifacts": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 },
			"uniqueItems": true
		},
		"familyPrefixes": {
			"type": "object",
			"additionalProperties": {
				"type": "string",
				"pattern": "^[A-Z][A-Z0-9-]*$"
			}
		},
		"constructRegister": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["id", "title", "family", "sources", "decidedBy"],
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"title": { "type": "string", "minLength": 1 },
					"family": { "$ref": "corpus-case.schema.json#/$defs/family" },
					"sources": {
						"type": "array",
						"minItems": 1,
						"items": { "type": "string", "minLength": 1 },
						"uniqueItems": true
					},
					"decidedBy": { "enum": ["schema", "cross-field", "compatibility"] },
					"criterion": { "type": "string", "minLength": 1 },
					"criterionQuote": { "type": "string", "minLength": 1 },
					"notApplicable": {
						"type": "array",
						"items": {
							"type": "object",
							"required": ["class", "justification", "citation"],
							"properties": {
								"class": {
									"enum": ["positive", "negative", "boundary", "evolution"]
								},
								"justification": { "type": "string", "minLength": 1 },
								"citation": { "type": "string", "minLength": 1 }
							},
							"additionalProperties": false
						}
					}
				},
				"additionalProperties": false
			}
		},
		"unmetAreas": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "title", "owningIssues", "rationale"],
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"title": { "type": "string", "minLength": 1 },
					"owningIssues": {
						"type": "array",
						"minItems": 1,
						"items": { "type": "string", "minLength": 1 }
					},
					"rationale": { "type": "string", "minLength": 1 }
				},
				"additionalProperties": false
			}
		},
		"bases": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": ["id", "path", "digest"],
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"path": { "type": "string", "minLength": 1 },
					"digest": {
						"$ref": "https://schemas.agent-ix.org/filament-core-data/v1/common.schema.json#/$defs/sha256"
					}
				},
				"additionalProperties": false
			}
		},
		"cases": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": [
					"id",
					"path",
					"family",
					"class",
					"digest",
					"expectedDigest"
				],
				"properties": {
					"id": { "$ref": "corpus-case.schema.json#/$defs/caseId" },
					"path": { "type": "string", "minLength": 1 },
					"family": { "$ref": "corpus-case.schema.json#/$defs/family" },
					"class": {
						"enum": ["positive", "negative", "boundary", "evolution"]
					},
					"digest": {
						"$ref": "https://schemas.agent-ix.org/filament-core-data/v1/common.schema.json#/$defs/sha256"
					},
					"expectedDigest": {
						"$ref": "https://schemas.agent-ix.org/filament-core-data/v1/common.schema.json#/$defs/sha256"
					}
				},
				"additionalProperties": false
			}
		},
		"corpusDigest": {
			"$ref": "https://schemas.agent-ix.org/filament-core-data/v1/common.schema.json#/$defs/sha256"
		}
	},
	"additionalProperties": false
}
