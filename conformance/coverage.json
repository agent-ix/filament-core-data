	"unmetAreas": [
		{
			"id": "UA-serialization-parity",
			"title": "Cross-language generated-package serialization and deserialization parity",
			"owningIssues": [
				"agent-ix/filament-core-data#21",
				"agent-ix/filament-core-data#22",
				"agent-ix/filament-core-data#23",
				"agent-ix/filament-core-data#11"
			],
			"rationale": "No generated Rust, TypeScript, or Python package exists to serialize; the corpus judges the IR document layer only and records the gap rather than claiming it."
		},
		{
			"id": "UA-live-adapters",
			"title": "A running implementation on any adapter slot",
			"owningIssues": [
				"agent-ix/filament-core-data#19",
				"agent-ix/filament-core-data#21",
				"agent-ix/filament-core-data#22",
				"agent-ix/filament-core-data#23"
			],
			"rationale": "Every declared adapter is unavailable until its owning issue ships a command that emits an adapter result; the harness records the unmet rows and counts none of them as a pass."
		},
		{
			"id": "UA-semantic-core-grammar",
			"title": "Conformance cases over the semantic-core declaration grammar itself",
			"owningIssues": [
				"agent-ix/filament-core-data#11",
				"agent-ix/filament-core-data#36"
			],
			"rationale": "The corpus judges lowered IR documents, not the L3 grammar that produces them; grammar conformance is gated by issue #35's own suite."
		}
	]
