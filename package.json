{
	"name": "@agent-ix/filament-core-data",
	"version": "0.1.0",
	"description": "Semantic contract compiler and generated kernel packages for Agent IX.",
	"author": "Agent IX",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.4",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome format . && tsc --noEmit -p tsconfig.json && node scripts/test-matrix-summary.mjs --check && node scripts/build-compatibility-cases.mjs --check && node scripts/build-evolution-goldens.mjs --check && node scripts/build-compiler-docs.mjs --check",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"spike:typespec": "node spikes/typespec-feasibility/scripts/run-experiment.mjs",
		"spike:typespec:check": "node spikes/typespec-feasibility/scripts/run-experiment.mjs --check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@types/node": "^22.10.0",
		"@typespec/compiler": "1.15.0",
		"@typespec/json-schema": "1.15.0",
		"@typespec/protobuf": "0.85.0",
		"@typespec/versioning": "0.85.0",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"apache-arrow": "21.2.0",
		"protobufjs": "8.8.0",
		"typescript": "^5.9.3",
		"vitest": "^1.4.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/agent-ix/filament-core-data.git"
	}
}
