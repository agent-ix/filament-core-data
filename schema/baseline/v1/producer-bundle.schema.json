{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.agent-ix.org/filament-core-data/baseline/v1/producer-bundle.schema.json",
	"title": "Filament Baseline 1.2.0 producer bundle",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"baselineVersion",
		"model",
		"relationships",
		"population",
		"observationRecords",
		"window",
		"configuration",
		"closure"
	],
	"properties": {
		"baselineVersion": { "const": "1.2.0" },
		"model": { "$ref": "#/$defs/model" },
		"relationships": {
			"type": "array",
			"items": { "$ref": "#/$defs/relationship" }
		},
		"population": { "$ref": "#/$defs/population" },
		"observationRecords": {
			"type": "array",
			"items": { "$ref": "#/$defs/record" }
		},
		"availability": {
			"type": "array",
			"items": { "$ref": "#/$defs/availability" }
		},
		"window": { "$ref": "#/$defs/window" },
		"configuration": { "$ref": "#/$defs/configuration" },
		"closure": { "$ref": "#/$defs/closure" },
		"correspondences": {
			"type": "array",
			"items": { "$ref": "#/$defs/correspondence" }
		}
	},
	"$defs": {
		"identity": { "type": "string", "minLength": 1 },
		"digest": {
			"type": "object",
			"additionalProperties": false,
			"required": ["algorithm", "domain", "version", "value"],
			"properties": {
				"algorithm": { "const": "sha256" },
				"domain": { "enum": ["filament-canonical-json-1", "quire-native-bytes-1"] },
				"version": { "const": "1" },
				"value": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
			}
		},
		"revision": {
			"type": "object",
			"additionalProperties": false,
			"required": ["namespace", "value"],
			"properties": {
				"namespace": {
					"enum": [
						"filament-core-data/producer-object-revision-1",
						"quire-native/definition-revision-1"
					]
				},
				"value": { "type": "string", "minLength": 1 }
			}
		},
		"multiplicity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["lower"],
			"properties": {
				"lower": { "type": "integer", "minimum": 0 },
				"upper": { "type": "integer", "minimum": 0 },
				"ordered": { "type": "boolean" },
				"unique": { "type": "boolean" }
			}
		},
		"field": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"fieldIdentity",
				"presence",
				"multiplicity",
				"nullable",
				"defaultKind"
			],
			"properties": {
				"fieldIdentity": { "$ref": "#/$defs/identity" },
				"presence": { "enum": ["required", "optional"] },
				"multiplicity": { "$ref": "#/$defs/multiplicity" },
				"nullable": { "type": "boolean" },
				"defaultKind": {
					"enum": ["none", "semantic", "representation", "migration"]
				},
				"defaultValue": {}
			}
		},
		"modelType": {
			"type": "object",
			"additionalProperties": false,
			"required": ["typeIdentity", "fields"],
			"properties": {
				"typeIdentity": { "$ref": "#/$defs/identity" },
				"fields": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/field" }
				}
			}
		},
		"model": {
			"type": "object",
			"additionalProperties": false,
			"required": ["modelIdentity", "digest", "profileIdentities", "types"],
			"properties": {
				"modelIdentity": { "$ref": "#/$defs/identity" },
				"digest": { "$ref": "#/$defs/digest" },
				"profileIdentities": {
					"type": "array",
					"items": { "$ref": "#/$defs/identity" },
					"uniqueItems": true
				},
				"types": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/modelType" }
				}
			}
		},
		"endpoint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["endpointIdentity", "typeIdentity", "role", "multiplicity"],
			"properties": {
				"endpointIdentity": { "$ref": "#/$defs/identity" },
				"typeIdentity": { "$ref": "#/$defs/identity" },
				"role": { "type": "string", "minLength": 1 },
				"multiplicity": { "$ref": "#/$defs/multiplicity" }
			}
		},
		"relationship": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"relationshipIdentity",
				"relationshipName",
				"source",
				"target",
				"semantics"
			],
			"properties": {
				"relationshipIdentity": { "$ref": "#/$defs/identity" },
				"relationshipName": { "type": "string", "minLength": 1 },
				"source": { "$ref": "#/$defs/endpoint" },
				"target": { "$ref": "#/$defs/endpoint" },
				"semantics": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"category",
						"direction",
						"composite",
						"lifecycle",
						"ownership"
					],
					"properties": {
						"category": { "type": "string", "minLength": 1 },
						"direction": { "type": "string", "minLength": 1 },
						"composite": { "type": "boolean" },
						"lifecycle": { "type": "string", "minLength": 1 },
						"ownership": { "type": "string", "minLength": 1 }
					}
				}
			}
		},
		"memberState": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["state"],
					"properties": { "state": { "const": "absent" } }
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["state"],
					"properties": { "state": { "const": "present-null" } }
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["state", "value"],
					"properties": {
						"state": { "const": "present-value" },
						"value": { "type": "array" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["state", "value"],
					"properties": {
						"state": { "const": "invalid" },
						"value": {
							"type": "object",
							"additionalProperties": false,
							"required": ["reason"],
							"properties": { "reason": { "type": "string", "minLength": 1 } }
						}
					}
				}
			]
		},
		"member": {
			"type": "object",
			"additionalProperties": false,
			"required": ["objectIdentity", "typeIdentity", "fields"],
			"properties": {
				"objectIdentity": { "$ref": "#/$defs/identity" },
				"typeIdentity": { "$ref": "#/$defs/identity" },
				"fields": {
					"type": "object",
					"additionalProperties": { "$ref": "#/$defs/memberState" }
				}
			}
		},
		"relationshipInstance": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"relationshipIdentity",
				"sourceObjectIdentity",
				"targetObjectIdentity"
			],
			"properties": {
				"relationshipIdentity": { "$ref": "#/$defs/identity" },
				"sourceObjectIdentity": { "$ref": "#/$defs/identity" },
				"targetObjectIdentity": { "$ref": "#/$defs/identity" }
			}
		},
		"population": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"populationIdentity",
				"digest",
				"modelIdentity",
				"profileIdentity",
				"closedWorld",
				"declaredObjectIdentities",
				"members",
				"relationshipInstances"
			],
			"properties": {
				"populationIdentity": { "$ref": "#/$defs/identity" },
				"digest": { "$ref": "#/$defs/digest" },
				"modelIdentity": { "$ref": "#/$defs/identity" },
				"profileIdentity": { "$ref": "#/$defs/identity" },
				"closedWorld": { "type": "boolean" },
				"declaredObjectIdentities": {
					"type": "array",
					"items": { "$ref": "#/$defs/identity" },
					"uniqueItems": true
				},
				"members": { "type": "array", "items": { "$ref": "#/$defs/member" } },
				"relationshipInstances": {
					"type": "array",
					"items": { "$ref": "#/$defs/relationshipInstance" }
				}
			}
		},
		"record": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"observationRecordIdentity",
				"memberObjectIdentity",
				"sequence"
			],
			"properties": {
				"observationRecordIdentity": { "$ref": "#/$defs/identity" },
				"memberObjectIdentity": { "$ref": "#/$defs/identity" },
				"sequence": { "type": "integer", "minimum": 0 }
			}
		},
		"availability": {
			"type": "object",
			"additionalProperties": false,
			"required": ["observationRecordIdentity", "reason"],
			"properties": {
				"observationRecordIdentity": { "$ref": "#/$defs/identity" },
				"reason": { "type": "string", "minLength": 1 }
			}
		},
		"window": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"windowIdentity",
				"digest",
				"populationIdentity",
				"coverage",
				"observationRecordIdentities"
			],
			"properties": {
				"windowIdentity": { "$ref": "#/$defs/identity" },
				"digest": { "$ref": "#/$defs/digest" },
				"populationIdentity": { "$ref": "#/$defs/identity" },
				"coverage": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["clockFamily", "startInclusive", "endExclusive"],
							"properties": {
								"clockFamily": { "const": "event-position" },
								"startInclusive": { "type": "integer", "minimum": 0 },
								"endExclusive": { "type": "integer", "minimum": 0 }
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": [
								"clockFamily",
								"epoch",
								"periodNumerator",
								"periodDenominator",
								"unit",
								"startInclusive",
								"endExclusive"
							],
							"properties": {
								"clockFamily": { "const": "fixed-sample" },
								"epoch": { "type": "string" },
								"periodNumerator": { "type": "integer" },
								"periodDenominator": { "type": "integer", "minimum": 0 },
								"unit": { "type": "string", "minLength": 1 },
								"startInclusive": { "type": "integer", "minimum": 0 },
								"endExclusive": { "type": "integer", "minimum": 0 }
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["clockFamily", "startInclusive", "endExclusive"],
							"properties": {
								"clockFamily": { "const": "timestamp" },
								"startInclusive": { "type": "string" },
								"endExclusive": { "type": "string" }
							}
						}
					]
				},
				"observationRecordIdentities": {
					"type": "array",
					"items": { "$ref": "#/$defs/identity" }
				}
			}
		},
		"configuration": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"configurationIdentity",
				"baselineVersion",
				"digest",
				"modelAuthority",
				"profileIdentities",
				"adapterIdentities",
				"mappingTargets",
				"lossPolicy",
				"resourceLimits",
				"trustedReferences"
			],
			"properties": {
				"configurationIdentity": { "$ref": "#/$defs/identity" },
				"baselineVersion": { "const": "1.2.0" },
				"digest": { "$ref": "#/$defs/digest" },
				"modelAuthority": { "$ref": "#/$defs/identity" },
				"profileIdentities": {
					"type": "array",
					"items": { "$ref": "#/$defs/identity" },
					"uniqueItems": true
				},
				"adapterIdentities": {
					"type": "array",
					"items": { "$ref": "#/$defs/identity" },
					"uniqueItems": true
				},
				"mappingTargets": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"lossPolicy": { "$ref": "#/$defs/identity" },
				"digestSelections": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["domain", "version"],
						"properties": {
							"domain": { "enum": ["filament-canonical-json-1", "quire-native-bytes-1"] },
							"version": { "const": "1" }
						}
					},
					"uniqueItems": true
				},
				"revisionNamespaces": {
					"type": "array",
					"items": {
						"enum": [
							"filament-core-data/producer-object-revision-1",
							"quire-native/definition-revision-1"
						]
					},
					"uniqueItems": true
				},
				"resourceLimits": {
					"type": "object",
					"additionalProperties": false,
					"required": ["numericResourceLimit"],
					"properties": {
						"numericResourceLimit": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"maximumCoefficientDigits",
								"maximumExponentMagnitude"
							],
							"properties": {
								"maximumCoefficientDigits": { "type": "integer", "minimum": 1 },
								"maximumExponentMagnitude": { "type": "integer", "minimum": 1 }
							}
						},
						"declaredBounds": {
							"type": "object",
							"additionalProperties": { "type": "integer", "minimum": 0 }
						}
					}
				},
				"trustedReferences": {
					"type": "array",
					"items": { "$ref": "#/$defs/identity" },
					"uniqueItems": true
				}
			}
		},
		"closure": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"modelIdentity",
				"modelDigest",
				"configurationIdentity",
				"configurationDigest"
			],
			"properties": {
				"modelIdentity": { "$ref": "#/$defs/identity" },
				"modelDigest": { "$ref": "#/$defs/digest" },
				"configurationIdentity": { "$ref": "#/$defs/identity" },
				"configurationDigest": { "$ref": "#/$defs/digest" },
				"populationIdentity": { "$ref": "#/$defs/identity" },
				"populationDigest": { "$ref": "#/$defs/digest" },
				"windowIdentity": { "$ref": "#/$defs/identity" },
				"windowDigest": { "$ref": "#/$defs/digest" }
			}
		},
		"native": {
			"type": "object",
			"additionalProperties": false,
			"required": ["identity", "revision", "rawByteDigest"],
			"properties": {
				"identity": { "$ref": "#/$defs/identity" },
				"revision": { "$ref": "#/$defs/revision" },
				"rawByteDigest": { "$ref": "#/$defs/digest" }
			}
		},
		"correspondence": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"bindingRelationIdentity",
				"producer",
				"native",
				"nativeDefinitionClosure",
				"configurationIdentity"
			],
			"properties": {
				"bindingRelationIdentity": { "$ref": "#/$defs/identity" },
				"producer": {
					"type": "object",
					"additionalProperties": false,
					"required": ["objectKind", "identity", "revision", "digest"],
					"properties": {
						"objectKind": { "type": "string", "minLength": 1 },
						"identity": { "$ref": "#/$defs/identity" },
						"revision": { "$ref": "#/$defs/revision" },
						"digest": { "$ref": "#/$defs/digest" }
					}
				},
				"native": { "$ref": "#/$defs/native" },
				"nativeDefinitionClosure": {
					"type": "array",
					"items": { "$ref": "#/$defs/native" }
				},
				"configurationIdentity": { "$ref": "#/$defs/identity" }
			}
		}
	}
}
