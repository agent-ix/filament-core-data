{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.agent-ix.org/filament-core-data/v1/semantic-ir.schema.json",
	"title": "Filament semantic IR v1 (contract version 2.0.0)",
	"type": "object",
	"required": [
		"contractVersion",
		"source",
		"package",
		"types",
		"occurrences",
		"extensions",
		"constructs"
	],
	"properties": {
		"contractVersion": {
			"enum": ["2.0.0"]
		},
		"source": {
			"type": "object",
			"required": ["identity", "version", "dialect", "digest"],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"version": {
					"$ref": "common.schema.json#/$defs/semver"
				},
				"dialect": {
					"$ref": "common.schema.json#/$defs/frontendDialect"
				},
				"digest": {
					"$ref": "common.schema.json#/$defs/sha256"
				}
			},
			"additionalProperties": false
		},
		"package": {
			"type": "object",
			"required": [
				"identity",
				"version",
				"manifestDigest",
				"mappingVersions",
				"profileVersions",
				"lockDigest"
			],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/packageIdentity"
				},
				"version": {
					"$ref": "common.schema.json#/$defs/semver"
				},
				"manifestDigest": {
					"$ref": "common.schema.json#/$defs/sha256"
				},
				"mappingVersions": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/semver"
					}
				},
				"profileVersions": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/semver"
					}
				},
				"lockDigest": {
					"$ref": "common.schema.json#/$defs/sha256"
				}
			},
			"additionalProperties": false
		},
		"types": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/typeDefinition"
			}
		},
		"occurrences": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/occurrence"
			}
		},
		"extensions": {
			"type": "array",
			"items": {
				"$ref": "common.schema.json#/$defs/extension"
			}
		},
		"constructs": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/construct"
			}
		},
		"populations": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/population"
			}
		}
	},
	"additionalProperties": false,
	"$defs": {
		"constraint": {
			"oneOf": [
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["min", "max", "exclusiveMin", "exclusiveMax"]
						},
						"operands": {
							"type": "object",
							"required": ["value"],
							"properties": {
								"value": {
									"anyOf": [
										{
											"type": "number"
										},
										{
											"type": "string",
											"minLength": 1
										}
									]
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["minLength", "maxLength"]
						},
						"operands": {
							"type": "object",
							"required": ["value"],
							"properties": {
								"value": {
									"type": "integer",
									"minimum": 0
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["pattern"]
						},
						"operands": {
							"type": "object",
							"required": ["regex", "dialect"],
							"properties": {
								"regex": {
									"type": "string",
									"minLength": 1
								},
								"dialect": {
									"const": "ecma-262"
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["enumValues"]
						},
						"operands": {
							"type": "object",
							"required": ["values"],
							"properties": {
								"values": {
									"type": "array",
									"minItems": 1,
									"uniqueItems": true,
									"items": {
										"anyOf": [
											{
												"type": "string"
											},
											{
												"type": "number"
											},
											{
												"type": "boolean"
											}
										]
									}
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["nonEmpty", "unique"]
						},
						"operands": {
							"type": "object",
							"properties": {},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["format"]
						},
						"operands": {
							"type": "object",
							"required": ["name"],
							"properties": {
								"name": {
									"type": "string",
									"pattern": "^[a-z0-9][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				}
			]
		},
		"decimalPolicy": {
			"type": "object",
			"required": ["precision", "scale"],
			"properties": {
				"precision": {"type": "integer", "minimum": 1, "maximum": 38},
				"scale": {"type": "integer", "minimum": 0, "maximum": 38}
			},
			"allOf": [
				{
					"if": {"properties": {"precision": {"const": 1}}},
					"then": {"properties": {"scale": {"maximum": 1}}}
				},
				{
					"if": {"properties": {"precision": {"const": 2}}},
					"then": {"properties": {"scale": {"maximum": 2}}}
				},
				{
					"if": {"properties": {"precision": {"const": 3}}},
					"then": {"properties": {"scale": {"maximum": 3}}}
				},
				{
					"if": {"properties": {"precision": {"const": 4}}},
					"then": {"properties": {"scale": {"maximum": 4}}}
				},
				{
					"if": {"properties": {"precision": {"const": 5}}},
					"then": {"properties": {"scale": {"maximum": 5}}}
				},
				{
					"if": {"properties": {"precision": {"const": 6}}},
					"then": {"properties": {"scale": {"maximum": 6}}}
				},
				{
					"if": {"properties": {"precision": {"const": 7}}},
					"then": {"properties": {"scale": {"maximum": 7}}}
				},
				{
					"if": {"properties": {"precision": {"const": 8}}},
					"then": {"properties": {"scale": {"maximum": 8}}}
				},
				{
					"if": {"properties": {"precision": {"const": 9}}},
					"then": {"properties": {"scale": {"maximum": 9}}}
				},
				{
					"if": {"properties": {"precision": {"const": 10}}},
					"then": {"properties": {"scale": {"maximum": 10}}}
				},
				{
					"if": {"properties": {"precision": {"const": 11}}},
					"then": {"properties": {"scale": {"maximum": 11}}}
				},
				{
					"if": {"properties": {"precision": {"const": 12}}},
					"then": {"properties": {"scale": {"maximum": 12}}}
				},
				{
					"if": {"properties": {"precision": {"const": 13}}},
					"then": {"properties": {"scale": {"maximum": 13}}}
				},
				{
					"if": {"properties": {"precision": {"const": 14}}},
					"then": {"properties": {"scale": {"maximum": 14}}}
				},
				{
					"if": {"properties": {"precision": {"const": 15}}},
					"then": {"properties": {"scale": {"maximum": 15}}}
				},
				{
					"if": {"properties": {"precision": {"const": 16}}},
					"then": {"properties": {"scale": {"maximum": 16}}}
				},
				{
					"if": {"properties": {"precision": {"const": 17}}},
					"then": {"properties": {"scale": {"maximum": 17}}}
				},
				{
					"if": {"properties": {"precision": {"const": 18}}},
					"then": {"properties": {"scale": {"maximum": 18}}}
				},
				{
					"if": {"properties": {"precision": {"const": 19}}},
					"then": {"properties": {"scale": {"maximum": 19}}}
				},
				{
					"if": {"properties": {"precision": {"const": 20}}},
					"then": {"properties": {"scale": {"maximum": 20}}}
				},
				{
					"if": {"properties": {"precision": {"const": 21}}},
					"then": {"properties": {"scale": {"maximum": 21}}}
				},
				{
					"if": {"properties": {"precision": {"const": 22}}},
					"then": {"properties": {"scale": {"maximum": 22}}}
				},
				{
					"if": {"properties": {"precision": {"const": 23}}},
					"then": {"properties": {"scale": {"maximum": 23}}}
				},
				{
					"if": {"properties": {"precision": {"const": 24}}},
					"then": {"properties": {"scale": {"maximum": 24}}}
				},
				{
					"if": {"properties": {"precision": {"const": 25}}},
					"then": {"properties": {"scale": {"maximum": 25}}}
				},
				{
					"if": {"properties": {"precision": {"const": 26}}},
					"then": {"properties": {"scale": {"maximum": 26}}}
				},
				{
					"if": {"properties": {"precision": {"const": 27}}},
					"then": {"properties": {"scale": {"maximum": 27}}}
				},
				{
					"if": {"properties": {"precision": {"const": 28}}},
					"then": {"properties": {"scale": {"maximum": 28}}}
				},
				{
					"if": {"properties": {"precision": {"const": 29}}},
					"then": {"properties": {"scale": {"maximum": 29}}}
				},
				{
					"if": {"properties": {"precision": {"const": 30}}},
					"then": {"properties": {"scale": {"maximum": 30}}}
				},
				{
					"if": {"properties": {"precision": {"const": 31}}},
					"then": {"properties": {"scale": {"maximum": 31}}}
				},
				{
					"if": {"properties": {"precision": {"const": 32}}},
					"then": {"properties": {"scale": {"maximum": 32}}}
				},
				{
					"if": {"properties": {"precision": {"const": 33}}},
					"then": {"properties": {"scale": {"maximum": 33}}}
				},
				{
					"if": {"properties": {"precision": {"const": 34}}},
					"then": {"properties": {"scale": {"maximum": 34}}}
				},
				{
					"if": {"properties": {"precision": {"const": 35}}},
					"then": {"properties": {"scale": {"maximum": 35}}}
				},
				{
					"if": {"properties": {"precision": {"const": 36}}},
					"then": {"properties": {"scale": {"maximum": 36}}}
				},
				{
					"if": {"properties": {"precision": {"const": 37}}},
					"then": {"properties": {"scale": {"maximum": 37}}}
				},
				{
					"if": {"properties": {"precision": {"const": 38}}},
					"then": {"properties": {"scale": {"maximum": 38}}}
				}
			],
			"additionalProperties": false
		},
		"field": {
			"type": "object",
			"required": [
				"identity",
				"name",
				"typeRef",
				"presence",
				"nullable",
				"defaultKind",
				"multiplicity",
				"origin"
			],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"typeRef": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"decimal": {
					"$ref": "#/$defs/decimalPolicy"
				},
				"presence": {
					"enum": ["required", "optional"]
				},
				"nullable": {
					"type": "boolean"
				},
				"defaultKind": {
					"enum": ["none", "semantic", "representation", "migration"]
				},
				"defaultValue": {},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				},
				"extensions": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/extension"
					}
				},
				"multiplicity": {
					"$ref": "#/$defs/multiplicity"
				},
				"unit": {
					"type": "string",
					"minLength": 1,
					"pattern": "^[!-~]+$"
				},
				"subsets": {
					"$ref": "#/$defs/identityList"
				},
				"redefines": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"textProfile": {
					"$ref": "common.schema.json#/$defs/textProfile"
				},
				"constraints": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/constraint"
					}
				}
			},
			"allOf": [
				{
					"if": {
						"type": "object",
						"properties": {
							"defaultKind": {
								"const": "none"
							}
						}
					},
					"then": {
						"type": "object",
						"not": {
							"type": "object",
							"required": ["defaultValue"]
						}
					},
					"else": {
						"type": "object",
						"required": ["defaultValue"]
					}
				}
			],
			"additionalProperties": false
		},
		"variant": {
			"type": "object",
			"required": ["identity", "name", "origin"],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"payloadType": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"typeDefinition": {
			"type": "object",
			"required": [
				"identity",
				"displayName",
				"kind",
				"roles",
				"origin",
				"constraints",
				"extensions",
				"unknownPolicy"
			],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"kind": {
					"anyOf": [
						{
							"enum": [
								"scalar",
								"record",
								"enum",
								"union",
								"alias",
								"sequence",
								"map",
								"reference"
							]
						},
						{
							"$ref": "#/$defs/constructKind"
						}
					]
				},
				"roles": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9.-]*:[a-zA-Z0-9][a-zA-Z0-9._-]*$"
					},
					"uniqueItems": true
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				},
				"constraints": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/constraint"
					}
				},
				"extensions": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/extension"
					}
				},
				"unknownPolicy": {
					"$ref": "common.schema.json#/$defs/unknownPolicy"
				},
				"scalar": {
					"enum": [
						"boolean",
						"integer",
						"number",
						"decimal",
						"string",
						"bytes",
						"date",
						"datetime",
						"duration",
						"uuid",
						"any"
					]
				},
				"decimal": {
					"$ref": "#/$defs/decimalPolicy"
				},
				"fields": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/field"
					}
				},
				"variants": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/variant"
					}
				},
				"target": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"items": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"values": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"relationships": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/relationship"
					}
				},
				"operations": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/operation"
					}
				},
				"clauses": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/clause"
					}
				},
				"supertypes": {
					"$ref": "#/$defs/identityList"
				},
				"abstract": {
					"type": "boolean"
				},
				"textProfile": {
					"$ref": "common.schema.json#/$defs/textProfile"
				},
				"identityFields": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/semanticIdentity"
					},
					"uniqueItems": true,
					"minItems": 1
				},
				"owner": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"members": {
					"$ref": "#/$defs/identityList"
				},
				"occurrenceField": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"states": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/state"
					}
				},
				"transitions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/transition"
					}
				},
				"steps": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/step"
					}
				},
				"persists": {
					"$ref": "#/$defs/identityList"
				},
				"vocabulary": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/term"
					}
				},
				"direction": {
					"enum": ["in", "out", "inout"]
				},
				"interfaceType": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"multiplicity": {
					"$ref": "#/$defs/multiplicity"
				},
				"declaredType": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"flowDirection": {
					"enum": ["source-to-target", "target-to-source", "bidirectional"]
				},
				"sourceEnd": {
					"$ref": "#/$defs/connectionEnd"
				},
				"targetEnd": {
					"$ref": "#/$defs/connectionEnd"
				},
				"sourceElement": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"targetElement": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"featureOrder": {
					"type": "array",
					"$ref": "#/$defs/identityList",
					"minItems": 1
				}
			},
			"allOf": [
				{
					"if": {
						"type": "object",
						"required": ["textProfile"]
					},
					"then": {
						"type": "object",
						"required": ["kind", "scalar"],
						"properties": {
							"kind": { "const": "scalar" },
							"scalar": { "const": "string" }
						}
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scalar"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["scalar"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "record"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["fields"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"enum": ["enum", "union"]
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["variants"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"enum": ["alias", "reference"]
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["target"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "sequence"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["items"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "map"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["values"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"enum": [
									"scalar",
									"enum",
									"union",
									"alias",
									"sequence",
									"map",
									"reference"
								]
							}
						},
						"required": ["kind"]
					},
					"then": {
						"type": "object",
						"properties": {
							"relationships": false,
							"operations": false
						}
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"type": "string"
							}
						},
						"required": ["kind"]
					},
					"then": {
						"type": "object",
						"properties": {
							"identityFields": false,
							"owner": false,
							"members": false,
							"occurrenceField": false,
							"states": false,
							"transitions": false,
							"steps": false,
							"persists": false,
							"vocabulary": false,
							"direction": false,
							"interfaceType": false,
							"multiplicity": false,
							"declaredType": false,
							"flowDirection": false,
							"sourceEnd": false,
							"targetEnd": false,
							"sourceElement": false,
							"targetElement": false,
							"featureOrder": false
						}
					}
				}
			],
			"additionalProperties": false
		},
		"occurrence": {
			"type": "object",
			"required": ["identity", "definition", "observedAt", "value"],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"definition": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"observedAt": {
					"type": "string",
					"format": "date-time"
				},
				"value": {}
			},
			"additionalProperties": false
		},
		"multiplicity": {
			"type": "object",
			"required": ["lower", "ordered", "unique"],
			"properties": {
				"lower": {
					"type": "integer",
					"minimum": 0
				},
				"upper": {
					"type": "integer",
					"minimum": 0
				},
				"ordered": {
					"type": "boolean"
				},
				"unique": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		},
		"connectionEnd": {
			"type": "object",
			"required": ["type"],
			"properties": {
				"type": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"multiplicity": {
					"$ref": "#/$defs/multiplicity"
				}
			},
			"additionalProperties": false
		},
		"relationship": {
			"type": "object",
			"required": [
				"identity",
				"category",
				"composite",
				"direction",
				"sourceEnd",
				"targetEnd",
				"origin"
			],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"category": {
					"enum": [
						"structural",
						"behavioral",
						"dataflow",
						"dependency",
						"realization",
						"governance",
						"traceability"
					]
				},
				"composite": {
					"type": "boolean"
				},
				"direction": {
					"enum": [
						"source-to-target",
						"target-to-source",
						"bidirectional",
						"undirected"
					]
				},
				"sourceEnd": {
					"$ref": "#/$defs/relationshipSourceEnd"
				},
				"targetEnd": {
					"$ref": "#/$defs/relationshipTargetEnd"
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"relationshipSourceEnd": {
			"type": "object",
			"required": ["role", "multiplicity", "type"],
			"properties": {
				"role": {
					"type": "string",
					"minLength": 1
				},
				"multiplicity": {
					"$ref": "#/$defs/multiplicity"
				},
				"type": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				}
			},
			"additionalProperties": false
		},
		"relationshipTargetEnd": {
			"type": "object",
			"required": ["multiplicity", "type"],
			"properties": {
				"role": {
					"type": "string",
					"minLength": 1
				},
				"multiplicity": {
					"$ref": "#/$defs/multiplicity"
				},
				"type": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				}
			},
			"additionalProperties": false
		},
		"operation": {
			"type": "object",
			"required": ["identity", "name", "params", "pre", "post", "origin"],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"params": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/field"
					}
				},
				"returns": {
					"type": "object",
					"required": ["typeRef", "multiplicity", "nullable"],
					"properties": {
						"typeRef": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"multiplicity": {
							"$ref": "#/$defs/multiplicity"
						},
						"nullable": {
							"type": "boolean"
						}
					},
					"additionalProperties": false
				},
				"pre": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/contractItem"
					},
					"uniqueItems": true
				},
				"post": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/contractItem"
					},
					"uniqueItems": true
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				},
				"redefines": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"frame": {
					"$ref": "#/$defs/frame"
				}
			},
			"additionalProperties": false
		},
		"clause": {
			"type": "object",
			"required": ["identity", "language", "clauseId", "text", "origin"],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"language": {
					"type": "string",
					"pattern": "^(quire|ocl|sysml|fretish|[a-z0-9][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*)$"
				},
				"clauseId": {
					"type": "string",
					"minLength": 1
				},
				"text": {
					"type": "string"
				},
				"sourceSpan": {
					"$ref": "common.schema.json#/$defs/sourceLocus"
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"identityList": {
			"type": "array",
			"items": {
				"$ref": "common.schema.json#/$defs/semanticIdentity"
			},
			"uniqueItems": true
		},
		"state": {
			"type": "object",
			"required": ["identity", "name", "origin"],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"transition": {
			"type": "object",
			"required": ["identity", "from", "to", "trigger", "emits", "origin"],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"from": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"to": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"trigger": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"guard": {
					"type": "string",
					"minLength": 1
				},
				"emits": {
					"$ref": "#/$defs/identityList"
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"step": {
			"type": "object",
			"required": [
				"identity",
				"name",
				"stepKind",
				"consumes",
				"emits",
				"origin"
			],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"stepKind": {
					"enum": ["command", "event", "decision", "compensation", "wait"]
				},
				"consumes": {
					"$ref": "#/$defs/identityList"
				},
				"emits": {
					"$ref": "#/$defs/identityList"
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"term": {
			"type": "object",
			"required": ["term", "doc", "origin"],
			"properties": {
				"term": {
					"type": "string",
					"minLength": 1
				},
				"doc": {
					"type": "string"
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"frame": {
			"type": "object",
			"required": ["modifies", "creates", "deletes"],
			"properties": {
				"modifies": {
					"$ref": "#/$defs/identityList"
				},
				"creates": {
					"$ref": "#/$defs/identityList"
				},
				"deletes": {
					"$ref": "#/$defs/identityList"
				}
			},
			"additionalProperties": false
		},
		"contractItem": {
			"anyOf": [
				{
					"type": "string",
					"minLength": 1
				},
				{
					"$ref": "#/$defs/inlineClause"
				}
			]
		},
		"inlineClause": {
			"type": "object",
			"required": ["language", "text", "origin"],
			"properties": {
				"language": {
					"type": "string",
					"pattern": "^(quire|ocl|sysml|fretish|[a-z0-9][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*)$"
				},
				"text": {
					"type": "string"
				},
				"sourceSpan": {
					"$ref": "common.schema.json#/$defs/sourceLocus"
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"population": {
			"type": "object",
			"required": [
				"identity",
				"displayName",
				"kind",
				"members",
				"extent",
				"origin"
			],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"kind": {
					"$ref": "#/$defs/constructKind"
				},
				"members": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/semanticIdentity"
					},
					"uniqueItems": true
				},
				"extent": {
					"enum": ["closed", "open"]
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"constructKind": {
			"type": "object",
			"required": ["module", "name"],
			"properties": {
				"module": {
					"$ref": "common.schema.json#/$defs/packageIdentity"
				},
				"name": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9_]*$"
				}
			},
			"additionalProperties": false
		},
		"construct": {
			"type": "object",
			"required": ["kind", "moduleVersion", "manifestDigest", "construct"],
			"properties": {
				"kind": {
					"$ref": "#/$defs/constructKind"
				},
				"moduleVersion": {
					"$ref": "common.schema.json#/$defs/semver"
				},
				"manifestDigest": {
					"$ref": "common.schema.json#/$defs/sha256"
				},
				"construct": {
					"$ref": "#/$defs/constructDeclaration"
				}
			},
			"additionalProperties": false
		},
		"constructDeclaration": {
			"type": "object",
			"required": ["identity", "shape", "members", "meaning"],
			"properties": {
				"identity": {
					"enum": ["identified", "value", "none"]
				},
				"shape": {
					"enum": [
						"record",
						"enumeration",
						"interface",
						"state_machine",
						"sequence",
						"namespace"
					]
				},
				"members": {
					"type": "object",
					"propertyNames": {
						"enum": [
							"fields",
							"variants",
							"relationships",
							"operations",
							"clauses",
							"supertypes",
							"abstract",
							"identityFields",
							"owner",
							"members",
							"occurrenceField",
							"states",
							"transitions",
							"steps",
							"persists",
							"vocabulary",
							"direction",
							"interfaceType",
							"multiplicity",
							"declaredType",
							"flowDirection",
							"sourceEnd",
							"targetEnd",
							"sourceElement",
							"targetElement",
							"featureOrder"
						]
					},
					"additionalProperties": {
						"enum": ["required", "optional", "forbidden"]
					}
				},
				"references": {
					"type": "object",
					"propertyNames": {
						"enum": [
							"owner",
							"members",
							"transitions",
							"steps",
							"persists",
							"interfaceType",
							"declaredType",
							"sourceEnd",
							"targetEnd",
							"sourceElement",
							"targetElement"
						]
					},
					"additionalProperties": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[a-z0-9][a-z0-9.-]*:[a-zA-Z0-9][a-zA-Z0-9._-]*$"
						},
						"minItems": 1,
						"uniqueItems": true
					}
				},
				"rules": {
					"type": "array",
					"items": {
						"enum": [
							"identity_field_required",
							"identity_field_forbidden",
							"min_clauses",
							"occurrence_field_required",
							"no_fields",
							"no_operations",
							"min_operations",
							"single_owner",
							"exclusive_membership",
							"members_not_namespace"
						]
					},
					"uniqueItems": true
				},
				"meaning": {
					"type": "string",
					"minLength": 1
				},
				"immutable": {
					"type": "boolean"
				}
			},
			"additionalProperties": false
		}
	}
}
