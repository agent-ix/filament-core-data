{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.agent-ix.org/filament-core-data/v1/semantic-ir.schema.json",
	"title": "Filament semantic IR v1 (contract versions 1.0.0 and 1.1.0)",
	"type": "object",
	"required": [
		"contractVersion",
		"source",
		"package",
		"types",
		"occurrences",
		"extensions"
	],
	"properties": {
		"contractVersion": {
			"enum": ["1.0.0", "1.1.0", "1.2.0"]
		},
		"source": {
			"type": "object",
			"required": ["identity", "version", "dialect", "digest"],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"version": {
					"$ref": "common.schema.json#/$defs/semver"
				},
				"dialect": {
					"oneOf": [
						{
							"const": "https://json-schema.org/draft/2020-12/schema"
						},
						{
							"$ref": "common.schema.json#/$defs/frontendDialect"
						}
					]
				},
				"digest": {
					"$ref": "common.schema.json#/$defs/sha256"
				}
			},
			"additionalProperties": false
		},
		"package": {
			"type": "object",
			"required": [
				"identity",
				"version",
				"manifestDigest",
				"mappingVersions",
				"profileVersions",
				"lockDigest"
			],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/packageIdentity"
				},
				"version": {
					"$ref": "common.schema.json#/$defs/semver"
				},
				"manifestDigest": {
					"$ref": "common.schema.json#/$defs/sha256"
				},
				"mappingVersions": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/semver"
					}
				},
				"profileVersions": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/semver"
					}
				},
				"lockDigest": {
					"$ref": "common.schema.json#/$defs/sha256"
				}
			},
			"additionalProperties": false
		},
		"types": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/typeDefinition"
			}
		},
		"occurrences": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/occurrence"
			}
		},
		"extensions": {
			"type": "array",
			"items": {
				"$ref": "common.schema.json#/$defs/extension"
			}
		},
		"populations": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/population"
			}
		}
	},
	"additionalProperties": false,
	"$defs": {
		"constraint": {
			"oneOf": [
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["min", "max", "exclusiveMin", "exclusiveMax"]
						},
						"operands": {
							"type": "object",
							"required": ["value"],
							"properties": {
								"value": {
									"anyOf": [
										{
											"type": "number"
										},
										{
											"type": "string",
											"minLength": 1
										}
									]
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["minLength", "maxLength"]
						},
						"operands": {
							"type": "object",
							"required": ["value"],
							"properties": {
								"value": {
									"type": "integer",
									"minimum": 0
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["pattern"]
						},
						"operands": {
							"type": "object",
							"required": ["regex", "dialect"],
							"properties": {
								"regex": {
									"type": "string",
									"minLength": 1
								},
								"dialect": {
									"const": "ecma-262"
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["enumValues"]
						},
						"operands": {
							"type": "object",
							"required": ["values"],
							"properties": {
								"values": {
									"type": "array",
									"minItems": 1,
									"uniqueItems": true,
									"items": {
										"anyOf": [
											{
												"type": "string"
											},
											{
												"type": "number"
											},
											{
												"type": "boolean"
											}
										]
									}
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["nonEmpty", "unique"]
						},
						"operands": {
							"type": "object",
							"properties": {},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				},
				{
					"type": "object",
					"required": [
						"identity",
						"keyword",
						"operands",
						"appliesTo",
						"diagnosticCode",
						"origin"
					],
					"properties": {
						"identity": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"appliesTo": {
							"$ref": "common.schema.json#/$defs/semanticIdentity"
						},
						"diagnosticCode": {
							"type": "string",
							"minLength": 1
						},
						"origin": {
							"$ref": "common.schema.json#/$defs/origin"
						},
						"keyword": {
							"enum": ["format"]
						},
						"operands": {
							"type": "object",
							"required": ["name"],
							"properties": {
								"name": {
									"type": "string",
									"pattern": "^[a-z0-9][a-z0-9.-]*:[A-Za-z0-9][A-Za-z0-9._-]*$"
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				}
			]
		},
		"field": {
			"type": "object",
			"required": [
				"identity",
				"name",
				"typeRef",
				"presence",
				"nullable",
				"defaultKind",
				"origin"
			],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"typeRef": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"presence": {
					"enum": ["required", "optional"]
				},
				"nullable": {
					"type": "boolean"
				},
				"defaultKind": {
					"enum": ["none", "semantic", "representation", "migration"]
				},
				"defaultValue": {},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				},
				"extensions": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/extension"
					}
				},
				"multiplicity": {
					"$ref": "#/$defs/multiplicity"
				},
				"unit": {
					"type": "string",
					"minLength": 1,
					"pattern": "^[!-~]+$"
				},
				"subsets": {
					"$ref": "#/$defs/identityList"
				},
				"redefines": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				}
			},
			"allOf": [
				{
					"if": {
						"type": "object",
						"properties": {
							"defaultKind": {
								"const": "none"
							}
						}
					},
					"then": {
						"type": "object",
						"not": {
							"type": "object",
							"required": ["defaultValue"]
						}
					},
					"else": {
						"type": "object",
						"required": ["defaultValue"]
					}
				}
			],
			"additionalProperties": false
		},
		"variant": {
			"type": "object",
			"required": ["identity", "name", "origin"],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"payloadType": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				}
			},
			"additionalProperties": false
		},
		"typeDefinition": {
			"type": "object",
			"required": [
				"identity",
				"displayName",
				"kind",
				"roles",
				"origin",
				"constraints",
				"extensions",
				"unknownPolicy"
			],
			"properties": {
				"identity": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"displayName": {
					"type": "string",
					"minLength": 1
				},
				"kind": {
					"enum": [
						"scalar",
						"record",
						"enum",
						"union",
						"alias",
						"sequence",
						"map",
						"reference",
						"entity",
						"value_object",
						"nested_entity",
						"aggregate_root",
						"enumeration",
						"event",
						"state_machine",
						"process",
						"repository",
						"domain"
					]
				},
				"roles": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-z0-9][a-z0-9.-]*:[a-zA-Z0-9][a-zA-Z0-9._-]*$"
					},
					"uniqueItems": true
				},
				"origin": {
					"$ref": "common.schema.json#/$defs/origin"
				},
				"constraints": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/constraint"
					}
				},
				"extensions": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/extension"
					}
				},
				"unknownPolicy": {
					"$ref": "common.schema.json#/$defs/unknownPolicy"
				},
				"scalar": {
					"enum": [
						"boolean",
						"integer",
						"number",
						"string",
						"bytes",
						"date",
						"datetime",
						"duration",
						"uuid",
						"any"
					]
				},
				"fields": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/field"
					}
				},
				"variants": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/variant"
					}
				},
				"target": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"items": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"values": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"relationships": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/relationship"
					}
				},
				"operations": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/operation"
					}
				},
				"clauses": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/clause"
					}
				},
				"supertypes": {
					"$ref": "#/$defs/identityList"
				},
				"abstract": {
					"type": "boolean"
				},
				"identityFields": {
					"type": "array",
					"items": {
						"$ref": "common.schema.json#/$defs/semanticIdentity"
					},
					"uniqueItems": true,
					"minItems": 1
				},
				"owner": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"members": {
					"$ref": "#/$defs/identityList"
				},
				"occurrenceField": {
					"$ref": "common.schema.json#/$defs/semanticIdentity"
				},
				"states": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/state"
					}
				},
				"transitions": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/transition"
					}
				},
				"steps": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/step"
					}
				},
				"persists": {
					"$ref": "#/$defs/identityList"
				},
				"vocabulary": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/term"
					}
				}
			},
			"allOf": [
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "scalar"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["scalar"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "record"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["fields"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"enum": ["enum", "union"]
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["variants"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"enum": ["alias", "reference"]
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["target"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "sequence"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["items"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "map"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["values"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"enum": [
									"record",
									"entity",
									"value_object",
									"nested_entity",
									"aggregate_root",
									"event",
									"state_machine",
									"process",
									"repository",
									"domain"
								]
							}
						}
					},
					"then": {},
					"else": {
						"type": "object",
						"properties": {
							"relationships": false,
							"operations": false
						}
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "entity"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["fields", "identityFields"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "value_object"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["fields"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "nested_entity"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["fields", "identityFields", "owner"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "aggregate_root"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["fields", "identityFields", "clauses", "members"],
						"properties": {
							"clauses": {
								"type": "array",
								"minItems": 1
							}
						}
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "enumeration"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["variants"],
						"not": {
							"required": ["fields"]
						}
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "event"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["fields", "occurrenceField"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "state_machine"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["operations", "states", "transitions"],
						"properties": {
							"operations": {
								"type": "array",
								"minItems": 1
							}
						}
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "process"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["fields", "identityFields", "steps"]
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "repository"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["operations", "persists"],
						"properties": {
							"operations": {
								"type": "array",
								"minItems": 1
							}
						},
						"not": {
							"required": ["fields"]
						}
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
								"const": "domain"
							}
						}
					},
					"then": {
						"type": "object",
						"required": ["members", "vocabulary"],
						"not": {
							"anyOf": [
								{
									"required": ["fields"]
								},
								{
									"required": ["operations"]
								}
							]
						}
					}
				},
				{
					"if": {
						"type": "object",
						"properties": {
							"kind": {
