{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.agent-ix.org/filament-core-data/v1/legacy-adapter.schema.json",
	"title": "Filament legacy adapter contract v1",
	"type": "object",
	"required": [
		"contractVersion",
		"identity",
		"sourceContract",
		"targetContract",
		"preservation",
		"omissions",
		"diagnostics",
		"retirementPrerequisites"
	],
	"properties": {
		"contractVersion": { "const": "1.0.0" },
		"identity": { "$ref": "common.schema.json#/$defs/semanticIdentity" },
		"sourceContract": { "$ref": "#/$defs/versionedContract" },
		"targetContract": { "$ref": "#/$defs/versionedContract" },
		"preservation": {
			"enum": [
				"byte-lossless",
				"structure-lossless",
				"semantic-lossless",
				"declared-lossy"
			]
		},
		"omissions": {
			"type": "array",
			"items": { "$ref": "common.schema.json#/$defs/semanticIdentity" },
			"uniqueItems": true
		},
		"diagnostics": {
			"type": "array",
			"items": { "$ref": "common.schema.json#/$defs/diagnostic" }
		},
		"retirementPrerequisites": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 },
			"uniqueItems": true
		}
	},
	"allOf": [
		{
			"if": {
				"type": "object",
				"properties": { "preservation": { "const": "declared-lossy" } }
			},
			"then": {
				"type": "object",
				"properties": { "omissions": { "type": "array", "minItems": 1 } }
			}
		}
	],
	"additionalProperties": false,
	"$defs": {
		"versionedContract": {
			"type": "object",
			"required": ["identity", "version"],
			"properties": {
				"identity": { "$ref": "common.schema.json#/$defs/semanticIdentity" },
				"version": { "$ref": "common.schema.json#/$defs/semver" }
			},
			"additionalProperties": false
		}
	}
}
