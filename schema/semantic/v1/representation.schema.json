{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.agent-ix.org/filament-core-data/v1/representation.schema.json",
	"title": "Filament representation contract v1",
	"type": "object",
	"required": [
		"contractVersion",
		"identity",
		"version",
		"format",
		"bestFit",
		"nonUses",
		"compatibilityMethod",
		"mapping"
	],
	"properties": {
		"contractVersion": { "const": "1.0.0" },
		"identity": { "$ref": "common.schema.json#/$defs/semanticIdentity" },
		"version": { "$ref": "common.schema.json#/$defs/semver" },
		"format": {
			"enum": [
				"markdown",
				"json",
				"postgresql",
				"protobuf",
				"avro",
				"arrow",
				"parquet",
				"csv",
				"tsv"
			]
		},
		"selected": { "type": "boolean" },
		"consumingBoundary": { "type": "string", "minLength": 1 },
		"bestFit": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 }
		},
		"nonUses": {
			"type": "array",
			"minItems": 1,
			"items": { "type": "string", "minLength": 1 }
		},
		"compatibilityMethod": { "type": "string", "minLength": 1 },
		"mapping": {
			"oneOf": [
				{ "$ref": "#/$defs/markdown" },
				{ "$ref": "#/$defs/json" },
				{ "$ref": "#/$defs/postgresql" },
				{ "$ref": "#/$defs/protobuf" },
				{ "$ref": "#/$defs/avro" },
				{ "$ref": "#/$defs/columnar" },
				{ "$ref": "#/$defs/delimited" }
			]
		}
	},
	"allOf": [
		{
			"if": {
				"type": "object",
				"required": ["selected"],
				"properties": { "selected": { "const": true } }
			},
			"then": { "type": "object", "required": ["consumingBoundary"] }
		},
		{
			"if": {
				"type": "object",
				"properties": { "format": { "const": "markdown" } }
			},
			"then": {
				"type": "object",
				"properties": { "mapping": { "$ref": "#/$defs/markdown" } }
			}
		},
		{
			"if": {
				"type": "object",
				"properties": { "format": { "const": "json" } }
			},
			"then": {
				"type": "object",
				"properties": { "mapping": { "$ref": "#/$defs/json" } }
			}
		},
		{
			"if": {
				"type": "object",
				"properties": { "format": { "const": "postgresql" } }
			},
			"then": {
				"type": "object",
				"properties": { "mapping": { "$ref": "#/$defs/postgresql" } }
			}
		},
		{
			"if": {
				"type": "object",
				"properties": { "format": { "const": "protobuf" } }
			},
			"then": {
				"type": "object",
				"properties": { "mapping": { "$ref": "#/$defs/protobuf" } }
			}
		},
		{
			"if": {
				"type": "object",
				"properties": { "format": { "const": "avro" } }
			},
			"then": {
				"type": "object",
				"properties": { "mapping": { "$ref": "#/$defs/avro" } }
			}
		},
		{
			"if": {
				"type": "object",
				"properties": { "format": { "const": "arrow" } }
			},
			"then": {
				"type": "object",
				"properties": {
					"mapping": {
						"allOf": [
							{ "$ref": "#/$defs/columnar" },
							{
								"type": "object",
								"properties": { "kind": { "const": "arrow" } }
							}
						]
					}
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": { "format": { "const": "parquet" } }
			},
			"then": {
				"type": "object",
				"properties": {
					"mapping": {
						"allOf": [
							{ "$ref": "#/$defs/columnar" },
							{
								"type": "object",
								"properties": { "kind": { "const": "parquet" } }
							}
						]
					}
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": { "format": { "const": "csv" } }
			},
			"then": {
				"type": "object",
				"properties": {
					"mapping": {
						"allOf": [
							{ "$ref": "#/$defs/delimited" },
							{ "type": "object", "properties": { "kind": { "const": "csv" } } }
						]
					}
				}
			}
		},
		{
			"if": {
				"type": "object",
				"properties": { "format": { "const": "tsv" } }
			},
			"then": {
				"type": "object",
				"properties": {
					"mapping": {
						"allOf": [
							{ "$ref": "#/$defs/delimited" },
							{ "type": "object", "properties": { "kind": { "const": "tsv" } } }
						]
					}
				}
			}
		}
	],
	"additionalProperties": false,
	"$defs": {
		"markdown": {
			"type": "object",
			"required": ["kind", "loci", "authority", "roundTrips"],
			"properties": {
				"kind": { "const": "markdown" },
				"loci": {
					"type": "array",
					"items": {
						"enum": [
							"frontmatter",
							"heading",
							"prose",
							"table",
							"list",
							"fence",
							"relationship",
							"body-extraction"
						]
					},
					"uniqueItems": true
				},
				"authority": {
					"enum": [
						"authored-bytes",
						"extracted-semantics",
						"rendered-presentation"
					]
				},
				"roundTrips": {
					"type": "array",
					"items": { "enum": ["byte", "structural", "semantic"] },
					"uniqueItems": true
				},
				"unrepresentable": {
					"type": "array",
					"items": { "$ref": "common.schema.json#/$defs/semanticIdentity" }
				}
			},
			"additionalProperties": false
		},
		"json": {
			"type": "object",
			"required": [
				"kind",
				"mediaType",
				"schemaIdentity",
				"canonicalization",
				"unknownFields"
			],
			"properties": {
				"kind": { "const": "json" },
				"mediaType": { "type": "string", "pattern": "^application/" },
				"schemaIdentity": { "type": "string", "format": "uri" },
				"discriminator": { "type": "string", "minLength": 1 },
				"canonicalization": { "type": "string", "minLength": 1 },
				"unknownFields": { "$ref": "common.schema.json#/$defs/unknownPolicy" }
			},
			"additionalProperties": false
		},
		"postgresql": {
			"type": "object",
			"required": [
				"kind",
				"logicalFields",
				"identity",
				"nullability",
				"constraints",
				"provenance",
				"physicalAuthority"
			],
			"properties": {
				"kind": { "const": "postgresql" },
				"logicalFields": {
					"type": "array",
					"items": { "$ref": "common.schema.json#/$defs/semanticIdentity" }
				},
				"identity": { "type": "string", "minLength": 1 },
				"nullability": { "type": "string", "minLength": 1 },
				"constraints": { "type": "array", "items": { "type": "string" } },
				"provenance": { "type": "string", "minLength": 1 },
				"physicalAuthority": { "const": "owning-consumer" }
			},
			"additionalProperties": false
		},
		"protobuf": {
			"type": "object",
			"required": [
				"kind",
				"package",
				"message",
				"fieldNumbers",
				"enumNumbers",
				"reservedNames",
				"reservedNumbers",
				"presence",
				"unknownFields",
				"descriptorCompatibility"
			],
			"properties": {
				"kind": { "const": "protobuf" },
				"package": { "type": "string", "minLength": 1 },
				"message": { "type": "string", "minLength": 1 },
				"fieldNumbers": {
					"type": "object",
					"additionalProperties": {
						"type": "integer",
						"minimum": 1,
						"maximum": 536870911
					}
				},
				"enumNumbers": {
					"type": "object",
					"additionalProperties": { "type": "integer", "minimum": 0 }
				},
				"reservedNames": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"reservedNumbers": {
					"type": "array",
					"items": { "type": "integer", "minimum": 1 },
					"uniqueItems": true
				},
				"presence": { "type": "string", "minLength": 1 },
				"unknownFields": { "$ref": "common.schema.json#/$defs/unknownPolicy" },
				"descriptorCompatibility": { "type": "string", "minLength": 1 }
			},
			"additionalProperties": false
		},
		"avro": {
			"type": "object",
			"required": ["kind", "protocolIdentity", "authority", "compatibility"],
			"properties": {
				"kind": { "const": "avro" },
				"protocolIdentity": { "type": "string", "minLength": 1 },
				"authority": { "const": "compatibility-representation" },
				"compatibility": { "type": "string", "minLength": 1 }
			},
			"additionalProperties": false
		},
		"columnar": {
			"type": "object",
			"required": [
				"kind",
				"fieldIdentities",
				"order",
				"types",
				"nullability",
				"metadata",
				"partitioning",
				"declaredLoss"
			],
			"properties": {
				"kind": { "enum": ["arrow", "parquet"] },
				"fieldIdentities": {
					"type": "array",
					"items": { "$ref": "common.schema.json#/$defs/semanticIdentity" }
				},
				"order": {
					"type": "array",
					"items": { "$ref": "common.schema.json#/$defs/semanticIdentity" }
				},
				"types": { "type": "object" },
				"nullability": { "type": "object" },
				"metadata": { "type": "object" },
				"partitioning": {
					"type": "array",
					"items": { "$ref": "common.schema.json#/$defs/semanticIdentity" }
				},
				"declaredLoss": {
					"type": "array",
					"items": { "$ref": "common.schema.json#/$defs/semanticIdentity" }
				}
			},
			"additionalProperties": false
		},
		"delimited": {
			"type": "object",
			"required": [
				"kind",
				"externalSchema",
				"encoding",
				"delimiter",
				"escape",
				"nullToken",
				"headerIdentity",
				"flatnessLimit",
				"implicitTypeInference"
			],
			"properties": {
				"kind": { "enum": ["csv", "tsv"] },
				"externalSchema": { "type": "string", "format": "uri" },
				"encoding": { "type": "string", "minLength": 1 },
				"delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
				"escape": { "type": "string", "minLength": 1 },
				"nullToken": { "type": "string" },
				"headerIdentity": { "type": "string", "minLength": 1 },
				"flatnessLimit": { "type": "integer", "minimum": 1 },
				"implicitTypeInference": { "const": false }
			},
			"additionalProperties": false
		}
	}
}
