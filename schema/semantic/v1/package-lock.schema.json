{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://schemas.agent-ix.org/filament-core-data/v1/package-lock.schema.json",
	"title": "Filament semantic package lock v1",
	"type": "object",
	"required": [
		"contractVersion",
		"rootPackage",
		"fingerprint",
		"canonicalization",
		"packages"
	],
	"properties": {
		"contractVersion": { "const": "1.0.0" },
		"rootPackage": { "$ref": "common.schema.json#/$defs/packageIdentity" },
		"fingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
		"canonicalization": {
			"type": "object",
			"required": ["algorithm", "digest", "included", "excluded"],
			"properties": {
				"algorithm": { "const": "RFC8785-JCS-with-identity-sorted-sets-v1" },
				"digest": { "const": "sha256" },
				"included": {
					"type": "array",
					"minItems": 1,
					"items": {
						"enum": [
							"schema-bytes",
							"manifest",
							"mappings",
							"profiles",
							"resolved-packages",
							"compiler-contract-version"
						]
					},
					"uniqueItems": true
				},
				"excluded": {
					"type": "array",
					"minItems": 1,
					"items": {
						"enum": [
							"object-order",
							"set-order",
							"source-path",
							"working-directory",
							"timestamp",
							"hostname",
							"locale"
						]
					},
					"uniqueItems": true
				}
			},
			"additionalProperties": false
		},
		"packages": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"required": [
					"identity",
					"version",
					"contentDigest",
					"sourceIdentity",
					"dependencies"
				],
				"properties": {
					"identity": { "$ref": "common.schema.json#/$defs/packageIdentity" },
					"version": { "$ref": "common.schema.json#/$defs/semver" },
					"contentDigest": { "$ref": "common.schema.json#/$defs/sha256" },
					"sourceIdentity": {
						"$ref": "common.schema.json#/$defs/semanticIdentity"
					},
					"dependencies": {
						"type": "array",
						"items": { "$ref": "common.schema.json#/$defs/packageIdentity" },
						"uniqueItems": true
					}
				},
				"additionalProperties": false
			}
		}
	},
	"additionalProperties": false
}
