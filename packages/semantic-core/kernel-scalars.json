{
	"$comment": "FR-032 kernel scalar representation table. Bounds are documentation for consumers; the semantic-core reader does not evaluate values against them.",
	"scalars": {
		"UUID": {
			"irScalar": "uuid",
			"bounds": "RFC 4122 128-bit",
			"serialization": "canonical lowercase hyphenated string",
			"unitAllowed": false
		},
		"Boolean": {
			"irScalar": "boolean",
			"bounds": "true | false",
			"serialization": "JSON boolean",
			"unitAllowed": false
		},
		"Integer": {
			"irScalar": "integer",
			"bounds": "default instance domain -9007199254740991 .. 9007199254740991; declared bounds i128::MIN .. i128::MAX",
			"serialization": "canonical integer string for values and bounds",
			"unitAllowed": true
		},
		"Decimal": {
			"irScalar": "decimal",
			"bounds": "TypeRef.decimal { precision, scale } required by the grammar rule",
			"serialization": "canonical decimal string",
			"unitAllowed": true
		},
		"Float32": {
			"irScalar": "float32",
			"bounds": "IEEE 754 binary32 finite values",
			"serialization": "JSON number",
			"unitAllowed": false
		},
		"Float64": {
			"irScalar": "float64",
			"bounds": "IEEE 754 binary64 finite values",
			"serialization": "JSON number",
			"unitAllowed": false
		},
		"String": {
			"irScalar": "string",
			"bounds": "minLength/maxLength in Unicode code points",
			"serialization": "JSON string (UTF-8)",
			"unitAllowed": false
		},
		"Timestamp": {
			"irScalar": "datetime",
			"bounds": "UTC instant, at most nanosecond precision",
			"serialization": "RFC 3339",
			"unitAllowed": true
		},
		"Duration": {
			"irScalar": "duration",
			"bounds": "ISO 8601 duration",
			"serialization": "ISO 8601",
			"unitAllowed": true
		},
		"Bytes": {
			"irScalar": "bytes",
			"bounds": "maxLength in bytes",
			"serialization": "base64 string",
			"unitAllowed": false
		},
		"JsonObject": {
			"irScalar": "any",
			"bounds": "any JSON value",
			"serialization": "JSON value",
			"unitAllowed": false
		}
	}
}
