{
	"$comment": "Issue #23, FR-077. Cross-property numeric conditions must survive generation.",
	"id": "constraints-decimal-policy",
	"construct": "decimal precision and scale condition",
	"note": "Scale must not exceed precision when both properties are present.",
	"detector": { "kind": "regex", "pattern": "_validate_decimalPolicy|__post_init__" },
	"schema": {
		"$defs": {
			"decimalPolicy": {
				"type": "object",
				"title": "DecimalPolicy",
				"required": ["precision", "scale"],
				"properties": {
					"precision": { "type": "integer", "minimum": 1, "maximum": 38 },
					"scale": { "type": "integer", "minimum": 0, "maximum": 38 }
				},
				"allOf": [
					{
						"if": { "properties": { "precision": { "const": 1 } } },
						"then": { "properties": { "scale": { "maximum": 1 } } }
					}
				],
				"additionalProperties": false
			}
		}
	},
	"expected": {
		"pydantic_v2_basemodel": true,
		"pydantic_v2_dataclass": true,
		"stdlib_dataclass": false,
		"typed_dict": false,
		"msgspec_struct": true
	}
}
