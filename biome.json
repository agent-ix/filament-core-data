{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist/**",
			"!**/*.map",
			"!**/.venv/**",
			"!conformance/.cases/**",
			"!spikes/typespec-feasibility/generated/**",
			"!spikes/typespec-feasibility/evidence/**",
			"!test/fixtures/compiler/compatibility/cases/**",
			"!test/fixtures/compiler/evolution/**"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	}
}
